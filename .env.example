# HomeFlow local environment (technical/01 §5). Copy to .env: `cp .env.example .env`
# .env is git-ignored. Nothing here is a real secret.

ENV=local
LOG_LEVEL=DEBUG

# --- database -----------------------------------------------------------------
# Inside compose the host is `postgres:5432`. From the host (psql, pytest -m integration)
# use localhost:$POSTGRES_HOST_PORT (default 5434) — 5432 and 5433 are already taken on this machine.
DATABASE_URL=postgresql+asyncpg://homeflow_app:homeflow_app@postgres:5432/homeflow
OWNER_DATABASE_URL=postgresql+asyncpg://homeflow_owner:homeflow_owner@postgres:5432/homeflow
# Host port the compose Postgres is published on (psql, pytest -m integration).
POSTGRES_HOST_PORT=5434

# --- files (MinIO locally, real S3 in AWS) ------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=homeflow-files
# Presigned URLs are signed against S3_ENDPOINT_URL (the in-compose host) and rewritten
# to this one so the browser can reach MinIO. Leave unset in AWS.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=homeflow
AWS_SECRET_ACCESS_KEY=homeflow123

# --- identity -----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_HD=pranava.in
SESSION_SECRET=local-dev-only-change-in-aws
HOMEFLOW_DEV_LOGIN=1
# Origin Google redirects back to: <PUBLIC_BASE_URL>/auth/google/callback
PUBLIC_BASE_URL=http://localhost:8001

# --- hosts --------------------------------------------------------------------
WORKSPACE_HOST=localhost:8001
CUSTOMER_HOST=my.localhost:8001

# --- notifications ------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
MESSAGING_PROVIDER=console
MESSAGING_API_KEY=

# --- runtime ------------------------------------------------------------------
HOMEFLOW_DEMO=1
TICKER_ENABLED=1

# --- v1 carry-overs (removed by TASKS Vivek 7 and Vivek 16) -------------------
# Set HOMEFLOW_V1_MONGO=1 and point MONGO_URL at a Mongo to run the v1 routers.
HOMEFLOW_V1_MONGO=0
MONGO_URL=mongodb://host.docker.internal:27017
DB_NAME=homeflow_v1
JWT_SECRET=local-dev-only-not-a-secret
CORS_ORIGINS=*
ATTACHMENT_STORAGE_ROOT=/app/.data/attachments
HOMEFLOW_MEMORY_DIR=/app/.data/memory
