# Copy to services/api/.env.local for local dev (gitignored — never commit
# real values). In prod these come from Secrets Manager / App Runner env,
# not a file (03-platform-deploy.md).

# --- db port ---
# Unset -> pglite persisted to ./.data/pglite (dev) or in-memory (tests,
# auto-detected via NODE_ENV=test / VITEST). Set -> pg Pool (prod/RDS).
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Local Postgres-in-Docker (docker-compose.yml at repo root, `docker compose up -d`):
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/homeflow

# --- server ---
PORT=8080
NODE_ENV=production

# --- identity (spec 01) ---
SESSION_SECRET=a-long-random-string

# --- files port ---
# Unset -> local-disk adapter (./.data/files, served by the API itself).
FILES_BUCKET=homeflow-files-975050032697
AWS_REGION=ap-south-1

# --- mailer port ---
# Unset SMTP_HOST -> file adapter (.eml files under ./.data/mail, tests/dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=a-gmail-app-password
SMTP_FROM="Pranava HomeFlow <you@gmail.com>"

# --- llm port ---
# Unset -> fake adapter (deterministic, zero cost, no network — tests).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
