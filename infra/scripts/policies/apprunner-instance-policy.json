{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3Files",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::homeflow-files-975050032697/*"
    },
    {
      "Sid": "S3ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::homeflow-files-975050032697"
    },
    {
      "Sid": "SecretsRead",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:ap-south-1:975050032697:secret:homeflow-database-url-*",
        "arn:aws:secretsmanager:ap-south-1:975050032697:secret:homeflow-session-secret-*",
        "arn:aws:secretsmanager:ap-south-1:975050032697:secret:homeflow-smtp-pass-*",
        "arn:aws:secretsmanager:ap-south-1:975050032697:secret:homeflow-openai-api-key-*"
      ]
    }
  ]
}
